#include <iostream>
#include <vector>
#include <unordered_map>
#include <utility>
using namespace std;

std::pair<int,int> twoSumBruteForce(const std::vector<int>& nums, int target){
    
    for (int i = 0; i < nums.size(); i++){
        for(int j = i + 1; j < nums.size(); j++){
            if(nums.at(i) + nums.at(j) == target){
                return {i, j};
            }
        }
    }
    return {-1,-1}; 
}

std::pair<int,int> twoSumHash(const std::vector<int>& nums, int target){
    
    std::unordered_map<int, int> hash_table;
    for (int i = 0; i < nums.size(); i++){

        int second_int = target - nums.at(i);

        if (hash_table.find(second_int)!= hash_table.end()){

            return {hash_table[second_int] , i};

            } else {
                hash_table[nums.at(i)] = i;
            }
    }
            return {-1, -1};
        }
void testCases(std::vector<int> nums, int target){
    std::pair<int, int> bruteForceResult = twoSumBruteForce(nums, target);
    std::pair<int, int> hashSumResult = twoSumHash(nums, target);
    bool bfValidResult = nums [bruteForceResult.first] + nums [bruteForceResult.second] == target;
        if(bfValidResult){
                std::cout << "BruteForce Valid: Yes" << std::endl;
              } else {
                std::cout << "BruteForceValid: No" << std::endl;
              }
    bool shValidResult = nums [hashSumResult.first] + nums [hashSumResult.second] == target;
        if(shValidResult){
                std::cout << "HashSum Valid: Yes" << std::endl;
              } else {
                std::cout << "HashSum Valid: No" << std::endl;
              }           
    std::cout << "BruteForce Function: " <<std::endl;
    std::cout << "Indices returned: "
              << bruteForceResult.first << ", "
              << bruteForceResult.second << std::endl;
    std::cout << "Values at Indices: " <<std::endl;
    std::cout << nums[bruteForceResult.first] << ", "
              << nums[bruteForceResult.second] << std::endl;

    std::cout <<"Hash-Based Lookup Function: " <<std::endl;
    std::cout << "Indices returned: "
              << hashSumResult.first << ", "
              << hashSumResult.second << std::endl;
    std::cout << "Values at Indices: " <<std::endl;
    std::cout << nums[hashSumResult.first] << ", "
              << nums[hashSumResult.second] << std::endl;

    std::cout <<"________________________________________" << std::endl;          
}
int main() {
    
    //Test 1:
    std::vector<int> nums1 {15, 4, 18, 8, 19, 22, 24, 59, 59, 20, 18, 12, 36, 42, 9};
    testCases(nums1, 24);

    //Test 2:
    std::vector<int> nums2 {1, 50, 25, 25, 50, 10, 1};
    testCases(nums2, 100);
    
    //Test 3:
    std::vector<int> nums3 {2, 4 , 6 , 8, 10, 12, 14, 16};
    testCases(nums3, 22);
    
    //Test 4:
    std::vector<int> nums4 {1000, 10, 1, 200000, 6, 500};
    testCases(nums4, 1500);

    //Test 5:
    std::vector<int> nums5  {15, 30, 60, 120, 240, 480};
    testCases(nums5, 29);
}
